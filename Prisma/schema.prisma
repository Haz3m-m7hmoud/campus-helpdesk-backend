generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================
// 1. Enums
// =====================================
enum Role {
  REPORTER
  AGENT
  TECHNICIAN
  MANAGER
  AUDITOR       // 👈 تم إضافة دور المراجع
}

enum TicketStatus {
  New
  Triaged
  Assigned
  In_Progress   // 👈 تم توحيدها وحذف الـ @map عشان متعملش تعارض
  Waiting
  Resolved
  Reopened
  Closed
}

// =====================================
// 2. Auth & Users
// =====================================
model User {
  id              String         @id @default(uuid()) 
  email           String         @unique
  name            String
  password        String            
  role            Role           @default(REPORTER)
  team_id         Int?           
  createdAt       DateTime       @default(now())

  team            SUPPORT_TEAM?  @relation(fields: [team_id], references: [team_id])
  reportedTickets TICKET[]       @relation("ReportedTickets")
  assignedTickets TICKET[]       @relation("AssignedTickets") // 👈 علاقة التيكتات المحولة للفني
  comments        COMMENT[]      
  attachments     ATTACHMENT[]   // 👈 المرفقات اللي رفعها
  audit_logs      AUDIT_LOG[]    // 👈 سجلات النظام اللي عملها
}

// =====================================
// 3. Entities
// =====================================
model SUPPORT_TEAM {
  team_id         Int          @id @default(autoincrement())
  name            String
  team_type       String       
  
  categories      CATEGORY[]
  assignments     ASSIGNMENT[]
  users           User[]       
  tickets         TICKET[]     // 👈 التيكتات المحولة للفريق
}

model CATEGORY {
  category_id     Int          @id @default(autoincrement())
  name            String       @unique
  description     String?
  default_team_id Int
  
  default_team    SUPPORT_TEAM @relation(fields: [default_team_id], references: [team_id])
  tickets         TICKET[]
  assets          ASSET[]
  predictions     PREDICTION[] @relation("PredictedCategory")
  overrides       PREDICTION[] @relation("OverrideCategory")
}

model LOCATION {
  location_id     Int          @id @default(autoincrement())
  name            String       @unique
  type            String       
  
  tickets         TICKET[]
  assets          ASSET[]
}

model ASSET {
  asset_id        String       @id 
  location_id     Int
  category_id     Int
  asset_type      String
  
  location        LOCATION     @relation(fields: [location_id], references: [location_id])
  category        CATEGORY     @relation(fields: [category_id], references: [category_id])
  tickets         TICKET[]
}

model SLA_POLICY {
  priority               String   @id 
  response_sla_hours     Int
  resolution_sla_hours   Int
  
  tickets                TICKET[]
}

// =====================================
// 4. Core TICKET Model
// =====================================
model TICKET {
  ticket_id              String       @id @default(uuid())
  reference_id           String?      @unique // 👈 رقم تيكت مقروء للطلاب (مثال: HLP-0001)
  reporter_id            String    
  assignee_id            String?      // 👈 تم إضافة الفني المسؤول
  team_id                Int?         // 👈 تم إضافة الفريق المسؤول
  title                  String
  description            String       @db.Text
  category_id            Int
  location_id            Int
  asset_id               String?
  issue_type             String    
  urgency                String    
  impact                 String    
  priority               String    
  status                 TicketStatus @default(New)
  
  created_at             DateTime     @default(now())
  first_response_at      DateTime?
  assigned_at            DateTime?
  resolved_at            DateTime?
  closed_at              DateTime?
  response_sla_due_at    DateTime? 
  resolution_sla_due_at  DateTime?
  
  user_responded         Boolean      @default(false)
  reopened               Boolean      @default(false)
  reopen_reason          String?
  duplicate_of           String?   
  is_emergency           Boolean      @default(false)
  escalated              Boolean      @default(false)
  escalation_reason      String?
  escalation_level       Int?         @db.SmallInt
  
  reporter               User         @relation("ReportedTickets", fields: [reporter_id], references: [id])
  assignee               User?        @relation("AssignedTickets", fields: [assignee_id], references: [id]) // 👈 الربط مع الفني
  team                   SUPPORT_TEAM? @relation(fields: [team_id], references: [team_id]) // 👈 الربط مع الفريق
  category               CATEGORY     @relation(fields: [category_id], references: [category_id])
  location               LOCATION     @relation(fields: [location_id], references: [location_id])
  asset                  ASSET?       @relation(fields: [asset_id], references: [asset_id])
  sla_policy             SLA_POLICY   @relation(fields: [priority], references: [priority])
  
  duplicate_ticket       TICKET?      @relation("DuplicateTickets", fields: [duplicate_of], references: [ticket_id])
  duplicates             TICKET[]     @relation("DuplicateTickets")

  assignments            ASSIGNMENT[]
  history                TICKET_STATUS_HISTORY[]
  prediction             PREDICTION?
  feedback               FEEDBACK?
  comments               COMMENT[]    
  attachments            ATTACHMENT[] // 👈 ربط المرفقات بالتيكت
}

// =====================================
// 5. Data Analytics & Relations
// =====================================
model ASSIGNMENT {
  assignment_id   String    @id @default(uuid())
  ticket_id       String
  team_id         Int
  assigned_at     DateTime  @default(now())
  completed_at    DateTime?

  ticket          TICKET       @relation(fields: [ticket_id], references: [ticket_id])
  team            SUPPORT_TEAM @relation(fields: [team_id], references: [team_id])
}

model PREDICTION {
  prediction_id          String   @id @default(uuid())
  ticket_id              String   @unique
  predicted_category_id  Int
  predicted_priority     String
  confidence             Decimal  @db.Decimal(5, 4) 
  model_version          String
  ai_overridden          Boolean  @default(false)
  override_category_id   Int?
  override_priority      String?
  created_at             DateTime @default(now())

  ticket                 TICKET   @relation(fields: [ticket_id], references: [ticket_id])
  predicted_category     CATEGORY @relation("PredictedCategory", fields: [predicted_category_id], references: [category_id])
  override_category      CATEGORY? @relation("OverrideCategory", fields: [override_category_id], references: [category_id])
}

model FEEDBACK {
  feedback_id            String   @id @default(uuid())
  ticket_id              String   @unique
  resolution_confirmed   Boolean
  rating                 Int      @db.SmallInt 
  reopen_reason          String?
  created_at             DateTime @default(now())

  ticket                 TICKET   @relation(fields: [ticket_id], references: [ticket_id])
}

model TICKET_STATUS_HISTORY {
  history_id      String   @id @default(uuid())
  ticket_id       String
  old_status      String?  
  new_status      String
  changed_at      DateTime @default(now())
  changed_by      String   

  ticket          TICKET   @relation(fields: [ticket_id], references: [ticket_id])
}

// =====================================
// 6. Comments & Attachments (تم إضافة المرفقات)
// =====================================
model COMMENT {
  comment_id  String   @id @default(uuid())
  ticket_id   String
  author_id   String
  body        String   @db.Text
  is_internal Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  ticket      TICKET   @relation(fields: [ticket_id], references: [ticket_id])
  author      User     @relation(fields: [author_id], references: [id]) 
}

model ATTACHMENT {
  attachment_id  String   @id @default(uuid())
  ticket_id      String
  uploader_id    String
  file_url       String
  file_name      String
  file_type      String
  file_size      Int
  is_private     Boolean  @default(false) // 👈 عشان لو مرفق داخلي للفنيين بس
  created_at     DateTime @default(now())

  ticket         TICKET   @relation(fields: [ticket_id], references: [ticket_id])
  uploader       User     @relation(fields: [uploader_id], references: [id])
}

// =====================================
// 7. Security & Auditing (جدول المراقبة)
// =====================================
model AUDIT_LOG {
  log_id         String   @id @default(uuid())
  action         String   // مثلا: "INVALID_TRANSITION", "DELETE_TICKET"
  entity_type    String   // مثلا: "TICKET", "USER"
  entity_id      String
  user_id        String
  details        String   @db.Text
  created_at     DateTime @default(now())

  user           User     @relation(fields: [user_id], references: [id])
}